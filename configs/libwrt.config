# LibWrt (LiBwrt/LibWrt) - Link NN6000 V2
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_link_nn6000-v2=y

# 系统(rootfs)分区 2GB（内核分区仍为 6MB）
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# LuCI + HTTPS + 中文界面（LibWrt 默认不带 LuCI，必须显式加）
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# 排障与常用工具（网口速率协商诊断要用 ethtool）
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_openssh-sftp-server=y

# Lucky（DDNS/端口转发/STUN 内网穿透，工作流从 kenzok8/small-package 复制 lucky 与 luci-app-lucky）
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y

# PassWall（来自 OpenWrt-Passwall 官方源，默认组件含 Xray/sing-box 等）
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
# 去掉 PassWall 的 Rust 组件（shadowsocks-rust、shadow-tls）：上一轮编译实测 rust 工具链
# 引导阶段下载 CI 版 LLVM 返回 404、重试 3 次失败（确定性失败，非网络抖动）。
# SS 功能由 Xray/sing-box 覆盖，影响很小。NaiveProxy 不依赖 rust，保留。
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set

# Argon 主题 + 设置插件（设置插件由工作流单独克隆 jerrykuku/luci-app-argon-config）
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# Docker 全套已于 2026-11-18 应用户要求移除（dockerd/docker/docker-compose/dockerman，用户反馈 Docker 影响网络）

# MosDNS（工作流从 sbwml/luci-app-mosdns v5 分支复制 mosdns、luci-app-mosdns、geo2txt）
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y

# 常用插件
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-i18n-wireguard-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# CLI 第一批
CONFIG_PACKAGE_vim-full=y
CONFIG_PACKAGE_git=y
CONFIG_PACKAGE_mmc-utils=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_bind-nslookup=y

# CLI 第二批：网络排障
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_mtr-nojson=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_lsof=y

# CLI 第二批：日常顺手（不要 nano；tmux 换 screen）
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_lrzsz=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_screen=y

# CLI 第二批：硬件外设
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_usbutils=y

# ps 换完整版（顶掉 BusyBox 的 ps）
CONFIG_PACKAGE_procps-ng-ps=y

# 解压组（unar 在 OpenWrt 无此包，用 unrar+unzip 替代）
CONFIG_PACKAGE_zstd=y
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_unrar=y
CONFIG_PACKAGE_unzip=y
